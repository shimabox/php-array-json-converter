{
    "name": "shimabox/php-array-json",
    "description": "Local web tool for converting between PHP array literals and JSON.",
    "type": "project",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "PhpArrayJson\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "PhpArrayJson\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse",
        "format": "php-cs-fixer fix --allow-risky=yes",
        "format-check": "php-cs-fixer fix --allow-risky=yes --dry-run --diff",
        "ci": [
            "@format-check",
            "@analyse",
            "@test"
        ]
    },
    "require": {
        "php": "^8.5"
    },
    "require-dev": {
        "phpunit/phpunit": "^12",
        "phpstan/phpstan": "^2",
        "friendsofphp/php-cs-fixer": "^3"
    }
}
